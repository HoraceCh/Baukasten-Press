// Baukasten Press — project-local Oh My OpenAgent (OMO) configuration.
//
// Overrides the inherited global config
// (~/.config/opencode/oh-my-openagent.jsonc) for THIS repository only.
// No global configuration is modified.
//
// Workflow: OpenCode Build is the interactive entry point; OMO subagents
// (Explore, Librarian, Oracle, Momus, Metis, Sisyphus-Junior) are dispatched
// when useful. Build stays responsible for integration, validation, and
// reporting.
//
// Model routing: "Ox Alpha" resolves to opencode/x-preview-f-free (verified
// available via smoke test). It is the preferred implementation model for
// Build, Explore, Librarian, and Sisyphus-Junior. Oracle, Momus, and Metis
// keep independent strong review/critique models (pinned below to protect
// against future global drift).
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",

  "agents": {
    "OpenCode-Builder": { "model": "opencode/x-preview-f-free" },
    "explore": { "model": "opencode/x-preview-f-free" },
    "librarian": { "model": "opencode/x-preview-f-free" },
    "sisyphus-junior": { "model": "opencode/x-preview-f-free" },
    "oracle": { "model": "openai/gpt-5.5" },
    "momus": { "model": "anthropic/claude-sonnet-4-6" },
    "metis": { "model": "anthropic/claude-sonnet-4-6" }
  }
}
