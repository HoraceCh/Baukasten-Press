{
  "permission": {
    "*": "deny",
    "read": {"*": "allow", ".env": "deny", ".env.*": "deny", "*.env": "deny", "*.env.*": "deny", "**/.env": "deny", "**/.env.*": "deny", "**/*.env": "deny", "**/*.env.*": "deny"},
    "glob": {"*": "allow"},
    "grep": {"*": "allow"},
    "list": {"*": "allow"},
    "edit": {"*": "deny"},
    "task": {"*": "deny"},
    "skill": {"*": "deny"},
    "external_directory": {"*": "deny"},
    "webfetch": {"*": "deny"},
    "websearch": {"*": "deny"},
    "codesearch": {"*": "deny"},
    "bash": {
      "*": "deny",
      "npm run validate": "allow",
      "npm run validate:agents": "allow",
      "npm run validate:git-safety": "allow",
      "npm run validate:environment": "allow",
      "npm run test:contracts": "allow",
      "npm run typecheck": "allow",
      "npm run lint": "allow",
      "npm run build": "allow",
      "rtk git status": "allow",
      "rtk git status --short": "allow",
      "rtk git diff": "allow",
      "rtk git diff --check": "allow",
      "rtk git diff --cached": "allow",
      "rtk git diff --cached --check": "allow",
      "rtk git diff --cached --name-status": "allow",
      "rtk git diff --cached --stat": "allow",
      "rtk git log": "allow",
      "rtk git log -1": "allow",
      "rtk git show HEAD": "allow",
      "rtk git show --format= --name-only HEAD": "allow",
      "rtk git rev-parse --show-toplevel": "allow",
      "rtk git rev-parse HEAD": "allow",
      "rtk git config --get remote.origin.url": "allow",
      "rtk git ls-files": "allow",
      "rtk git branch --show-current": "allow",
      "rtk git remote get-url origin": "allow"
    }
  }
}
